{
  "name": "bullyoff",
  "version": "0.0.0",
  "private": true,
  "description": "BULLY OFF — a deterministic field hockey simulation and coach/manager game for the web.",
  "author": "Jan Van Wassenhove (mITy.John)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' --filter './tools/**' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:manager": "pnpm --filter @bullyoff/manager dev",
    "simcli": "pnpm --filter @bullyoff/simcli start"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.1.3"
  }
}
