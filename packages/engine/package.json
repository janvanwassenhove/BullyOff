{
  "name": "@bullyoff/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Headless, deterministic field hockey match engine. tick(state, inputs) -> state, events. ZERO runtime deps.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/worker/worker.ts",
      "default": "./src/worker/worker.ts"
    },
    "./fixtures": {
      "types": "./src/sim/fixtures.ts",
      "default": "./src/sim/fixtures.ts"
    },
    "./naive": {
      "types": "./src/sim/naiveController.ts",
      "default": "./src/sim/naiveController.ts"
    },
    "./scenarios": {
      "types": "./src/sim/scenarios.ts",
      "default": "./src/sim/scenarios.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:browsers": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@bullyoff/rules": "workspace:*",
    "@bullyoff/shared": "workspace:*"
  }
}
