{
  "name": "@bullyoff/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Headless, deterministic field hockey match engine. tick(state, inputs) -> state, events. ZERO runtime deps.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bullyoff/rules": "workspace:*",
    "@bullyoff/shared": "workspace:*"
  }
}
