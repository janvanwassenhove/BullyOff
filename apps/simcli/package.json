{
  "name": "@bullyoff/simcli",
  "version": "0.0.0",
  "private": true,
  "description": "Node CLI: batch headless simulation and aggregate statistics for calibration.",
  "type": "module",
  "bin": { "bullyoff-sim": "./dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@bullyoff/engine": "workspace:*",
    "@bullyoff/shared": "workspace:*",
    "@bullyoff/worldgen": "workspace:*"
  }
}
